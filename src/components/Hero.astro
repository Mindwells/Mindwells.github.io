---
import Icon from './ui/Icon.astro';
import RetrievalViz from './RetrievalViz.astro';
import { profile, activeLinks } from '../data/profile';
import { researchAreas, researchSummary } from '../data/research';

const emailLink = activeLinks.find((link) => link.icon === 'mail');
const secondaryLinks = activeLinks.filter((link) => link.icon !== 'mail').slice(0, 3);
---

<section class="hero" id="top">
  <RetrievalViz />

  <div class="hero__inner container">
    <!--
      The status line is the first thing on the page on purpose: it answers
      "who is this and where are they" before any styling is appreciated.
    -->
    <p class="hero__status" data-reveal="up">
      <span class="hero__pulse" aria-hidden="true"></span>
      <span>{profile.role}</span>
      <span class="hero__status-sep" aria-hidden="true">·</span>
      <span class="hero__status-place">{profile.affiliation}</span>
    </p>

    <!--
      The headline is the research field itself, and the accent line is the
      two focus areas — the site owner's own terms, not a rewritten slogan.
      A title that quotes the person is more credible than one that performs
      on their behalf.
    -->
    <h1 class="hero__title">
      <span class="hero__title-line" data-reveal="up" data-reveal-delay="80">
        {researchSummary}
      </span>
      <span class="hero__title-line hero__title-line--accent" data-reveal="up" data-reveal-delay="170">
        <em>{researchAreas.map((area) => area.title).join(' · ')}</em>
      </span>
    </h1>

    <div class="hero__lower">
      <p class="hero__lede" data-reveal="up" data-reveal-delay="260">
        {profile.statement}
      </p>

      <ul class="hero__tags" data-reveal="up" data-reveal-delay="330">
        <li class="hero__tag hero__tag--lead">{researchSummary}</li>
        {researchAreas.map((area) => <li class="hero__tag">{area.title}</li>)}
      </ul>

      <div class="hero__actions" data-reveal="up" data-reveal-delay="400">
        {emailLink?.href && (
          <a class="button button--primary" href={emailLink.href}>
            <Icon name="mail" size={16} />
            <span>Get in touch</span>
          </a>
        )}
        <a class="button button--ghost" href="#research">
          <span>Research</span>
          <Icon name="arrowDown" size={16} />
        </a>

        {
          secondaryLinks.length > 0 && (
            <ul class="hero__links">
              {secondaryLinks.map((link) => (
                <li>
                  <a
                    class="hero__link"
                    href={link.href}
                    rel="me noopener noreferrer"
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    aria-label={link.label}
                  >
                    <Icon name={link.icon} size={17} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>

  <!-- Sentinel: the header condenses when this leaves the viewport. -->
  <div class="hero__sentinel" data-header-sentinel aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 52rem);
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 10vh, 8rem) var(--space-2xl);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__inner {
    position: relative;
    z-index: var(--z-base);
    width: 100%;
  }

  /* --- Status line --- */

  .hero__status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--ink-muted);
    max-width: none;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  .hero__status-place {
    color: var(--ink-subtle);
  }

  .hero__status-sep {
    color: var(--rule-strong);
  }

  /* A live dot — the only continuously moving element besides the canvas.
     It reads as "currently active" without saying it. */
  .hero__pulse {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--accent);
    position: relative;
    flex-shrink: 0;
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--accent);
    animation: pulse-ring 2.6s var(--ease-out) infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pulse::after {
      animation: none;
    }
  }

  /* --- Title --- */

  .hero__title {
    font-size: var(--step-7);
    line-height: 1.02;
    letter-spacing: -0.035em;
    /* Sized in `ch` so the field name breaks onto a second line rather than
       running past the measure at any viewport. */
    max-width: 16ch;
    margin-bottom: clamp(2.5rem, 7vh, 4.5rem);
    text-wrap: balance;
  }

  .hero__title-line {
    display: block;
  }

  /* The focus-area line is a deck, not a second headline: it has its own
     type scale so two long field names stay readable instead of wrapping
     into a wall at display size. */
  .hero__title-line--accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 0.85rem + 0.9vw, 1.6rem);
    line-height: 1.4;
    letter-spacing: var(--tracking-heading);
    color: var(--accent);
    margin-top: clamp(1rem, 2.2vw, 1.9rem);
    max-width: 34ch;
    text-wrap: pretty;
  }

  /* --- Lower block --- */

  .hero__lower {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    column-gap: var(--gutter);
    row-gap: var(--space-xl);
  }

  .hero__lede {
    grid-column: 1;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 34rem;
  }

  .hero__tags {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__tags li + li {
    margin-top: 0;
  }

  .hero__tag {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--ink-subtle);
    white-space: nowrap;
  }

  .hero__tag--lead {
    color: var(--accent);
  }

  .hero__actions {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* --- Buttons --- */

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.78rem 1.35rem;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.005em;
    border: 1px solid transparent;
    cursor: pointer;
    /* min target size for touch */
    min-height: 44px;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-spring);
  }

  .button :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .button--primary {
    background: var(--ink);
    color: var(--paper);
  }

  .button--primary:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
  }

  .button--primary:hover :global(svg) {
    transform: rotate(-8deg) scale(1.08);
  }

  .button--ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .button--ghost:hover {
    border-color: var(--ink);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .button--ghost:hover :global(svg) {
    transform: translateY(3px);
  }

  .button:active {
    transform: translateY(0) scale(0.985);
  }

  /* --- Inline social links --- */

  .hero__links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0 0 0 0.35rem;
    padding: 0;
  }

  .hero__links li + li {
    margin-top: 0;
  }

  .hero__link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    color: var(--ink-subtle);
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .hero__link:hover {
    color: var(--accent);
    background: var(--accent-wash);
  }

  /* --- Responsive --- */

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-block: var(--space-3xl) var(--space-2xl);
    }

    .hero__lower {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__tags {
      grid-column: 1;
      grid-row: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 0.4rem 0.75rem;
    }

    .hero__title {
      max-width: none;
    }
  }

  /* Phones: the display size would push the primary action below the fold,
     so the title steps down and the vertical rhythm tightens. The hero should
     still state who this is and offer a way to make contact on first screen. */
  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-2xl) var(--space-xl);
    }

    .hero__title {
      font-size: clamp(2.4rem, 9vw, 3.25rem);
      letter-spacing: -0.03em;
      line-height: 1.06;
      margin-bottom: var(--space-xl);
    }

    .hero__status {
      margin-bottom: var(--space-lg);
    }

    /* The positioning sentence is long; dropping it a step and tightening
       its leading keeps the actions on the first screen of a 360px phone. */
    .hero__lede {
      font-size: var(--step-0);
      line-height: 1.55;
    }

    .hero__lower {
      row-gap: var(--space-lg);
    }
  }

  @media (max-width: 520px) {
    .hero__actions {
      width: 100%;
    }

    .button {
      flex: 1 1 auto;
      justify-content: center;
    }

    .hero__links {
      margin-left: 0;
    }
  }

  .hero__sentinel {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }
</style>
