const d = paths[name] ?? '';
const isDecorative = !label;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={isDecorative ? undefined : 'img'}
  aria-hidden={isDecorative ? 'true' : undefined}
  aria-label={label}
  set:html={d}
/>
