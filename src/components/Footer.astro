---
import Icon from './ui/Icon.astro';
import { profile, activeLinks } from '../data/profile';

const year = new Date().getFullYear();
const emailLink = activeLinks.find((link) => link.icon === 'mail');
const socialLinks = activeLinks.filter((link) => link.icon !== 'mail');
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__identity">
        <p class="footer__name">{profile.name}</p>
        <p class="footer__affil">{profile.affiliationFull}</p>
      </div>

      {
        emailLink?.href && (
          <div class="footer__email">
            <span class="label">Email</span>
            <div class="footer__email-row">
              <a class="footer__email-link" href={emailLink.href}>
                {emailLink.handle}
              </a>
              <button
                class="footer__copy"
                type="button"
                data-copy={emailLink.handle}
                data-copy-label="Copy email address"
                aria-label="Copy email address"
              >
                <span class="footer__copy-icon footer__copy-icon--idle">
                  <Icon name="copy" size={14} />
                </span>
                <span class="footer__copy-icon footer__copy-icon--done">
                  <Icon name="check" size={14} />
                </span>
              </button>
              <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
            </div>
          </div>
        )
      }
    </div>

    <div class="footer__bottom">
      <p class="footer__copy-line">
        <span class="mono">© <span data-year>{year}</span> {profile.name}</span>
      </p>

      <ul class="footer__social">
        {
          socialLinks.map((link) => (
            <li>
              <a
                class="footer__social-link"
                href={link.href}
                rel="me noopener noreferrer"
                target={link.href.startsWith('http') ? '_blank' : undefined}
              >
                <Icon name={link.icon} size={16} />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    /* No top margin: the preceding section already contributes its full
       bottom padding, and stacking both produced a 2× gap that broke the
       page's vertical rhythm. */
    padding-block: var(--space-2xl) var(--space-xl);
    background: var(--paper);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .footer__name {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    letter-spacing: var(--tracking-heading);
    color: var(--ink);
    max-width: none;
  }

  .footer__affil {
    margin-top: 0.35rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
    max-width: 28rem;
  }

  .footer__email {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__email-row {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer__email-link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    position: relative;
  }

  /* Widens the hit target to ≥44px without shifting the underlined text. */
  .footer__email-link::before {
    content: '';
    position: absolute;
    inset: -11px -6px;
  }

  .footer__email-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--rule-strong);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .footer__email-link:hover {
    color: var(--accent);
  }

  .footer__email-link:hover::after {
    background: var(--accent);
  }

  .footer__copy {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-subtle);
    cursor: pointer;
    position: relative;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  /* 28px visual box, 44px+ hit target. */
  .footer__copy::after {
    content: '';
    position: absolute;
    inset: -9px;
  }

  .footer__copy:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .footer__copy.is-copied {
    color: var(--accent);
    border-color: var(--accent);
  }

  .footer__copy-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .footer__copy-icon--done {
    opacity: 0;
    transform: scale(0.6);
  }

  .footer__copy.is-copied .footer__copy-icon--idle {
    opacity: 0;
    transform: scale(0.6);
  }

  .footer__copy.is-copied .footer__copy-icon--done {
    opacity: 1;
    transform: none;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }

  .footer__copy-line {
    color: var(--ink-subtle);
    font-size: var(--step--2);
    max-width: none;
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .footer__social li + li {
    margin-top: 0;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
    /* The box would otherwise be the label's line height (~24px), which is
       below the 44px touch guideline on a phone. Padding expands the target
       and the matching negative margin keeps the visual position identical. */
    padding-block: 0.7rem;
    margin-block: -0.7rem;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
