---
import Base from '../layouts/Base.astro';

/**
 * 404 — treated as a real page, not an afterthought. A visitor who lands on a
 * dead link is still a visitor.
 *
 * The copy avoids first person: "I may have moved something" is a claim about
 * the site owner's actions that a generated page has no business making.
 */
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="not-found container">
    <p class="label">Error 404</p>
    <h1 class="not-found__title">
      This page isn't here.
    </h1>
    <p class="not-found__text">
      The link may be out of date, or the page may have moved. Everything on this site is
      reachable from the homepage.
    </p>
    <a class="not-found__link" href="/">
      <span>Back to the homepage</span>
      <span aria-hidden="true">→</span>
    </a>
  </section>
</Base>

<style>
  .not-found {
    min-height: 62svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-md);
    padding-block: var(--space-3xl);
  }

  .not-found__title {
    font-size: var(--step-5);
    max-width: 18ch;
  }

  .not-found__text {
    color: var(--ink-muted);
    max-width: 34rem;
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-sm);
    padding: 0.75rem 1.25rem;
    min-height: 44px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-full);
    color: var(--ink);
    font-size: var(--step--1);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-base) var(--ease-spring);
  }

  .not-found__link:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
