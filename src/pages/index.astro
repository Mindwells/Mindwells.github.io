---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import About from '../components/About.astro';
import ResearchAreas from '../components/ResearchAreas.astro';
import NewsList from '../components/NewsList.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import AwardList from '../components/AwardList.astro';
import Timeline from '../components/Timeline.astro';
import ExperienceList from '../components/ExperienceList.astro';
import Contact from '../components/Contact.astro';
import EmptyState from '../components/EmptyState.astro';

import { profile } from '../data/profile';
import { researchAreas, researchSummary } from '../data/research';
import { education } from '../data/education';
import { getEntries } from '../utils/content';

/**
 * Pull every collection once. Drafts are filtered out here so no individual
 * section has to remember to do it; empty collections short-circuit without
 * logging a warning.
 */
const [newsEntries, publicationEntries, awardEntries, experienceEntries] = await Promise.all([
  getEntries('news', ({ data }) => !data.draft),
  getEntries('publications', ({ data }) => !data.draft),
  getEntries('awards', ({ data }) => !data.draft),
  getEntries('experience', ({ data }) => !data.draft),
]);

/**
 * Entry bodies are Markdown, so they are rendered to components rather than
 * passed through as text. The collection templates invite you to write
 * Markdown there; emitting `entry.body` directly would print its syntax
 * verbatim.
 */
const bodyOf = async (entry: { body?: string }) =>
  entry.body?.trim() ? (await render(entry as never)).Content : null;

const newsItems = await Promise.all(
  newsEntries.map(async (entry) => ({
    date: entry.data.date,
    title: entry.data.title,
    tag: entry.data.tag,
    href: entry.data.href,
    Content: await bodyOf(entry),
  })),
);

const publicationItems = publicationEntries
  .map((entry) => ({ ...entry.data, id: entry.id }))
  .sort((a, b) => {
    if (a.featured !== b.featured) return a.featured ? -1 : 1;
    if (a.year !== b.year) return b.year - a.year;
    return a.title.localeCompare(b.title);
  });

const awardItems = await Promise.all(
  awardEntries.map(async (entry) => ({
    date: entry.data.date,
    title: entry.data.title,
    level: entry.data.level,
    issuer: entry.data.issuer,
    Content: await bodyOf(entry),
  })),
);

const experienceItems = (
  await Promise.all(
    experienceEntries.map(async (entry) => ({
      title: entry.data.title,
      organization: entry.data.organization,
      period: entry.data.period,
      location: entry.data.location,
      role: entry.data.role,
      href: entry.data.href,
      Content: await bodyOf(entry),
      start: entry.data.start,
    })),
  )
).sort((a, b) => b.start.getTime() - a.start.getTime());

const hasNews = newsItems.length > 0;
const hasPublications = publicationItems.length > 0;
const hasAwards = awardItems.length > 0;
const hasExperience = experienceItems.length > 0;
---

<Base description={profile.bio}>
  <Hero />

  <!-- 01 — About -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <SectionHeader index="01" title="About" id="about" />
      <About />
    </div>
  </section>

  <!-- 02 — Research -->
  <section class="section section--ruled" id="research" aria-labelledby="research-title">
    <div class="container">
      <SectionHeader
        index="02"
        title="Research"
        id="research"
        lede={`Focus areas within ${researchSummary}.`}
      />
      <ResearchAreas areas={researchAreas} />
    </div>
  </section>

  <!-- 03 — News -->
  <section
    class:list={['section', 'section--ruled', { 'section--tight': !hasNews }]}
    id="news"
    aria-labelledby="news-title"
  >
    <div class="container">
      <SectionHeader
        index="03"
        title="News"
        id="news"
        lede={hasNews ? 'Talks, papers, and moves, newest first.' : undefined}
      />
      {
        hasNews ? (
          <NewsList items={newsItems} />
        ) : (
          <EmptyState message="Paper acceptances and talk announcements will appear here as they happen." />
        )
      }
    </div>
  </section>

  <!-- 04 — Publications -->
  <section
    class:list={['section', 'section--ruled', { 'section--tight': !hasPublications }]}
    id="publications"
    aria-labelledby="publications-title"
  >
    <div class="container">
      <SectionHeader
        index="04"
        title="Publications"
        id="publications"
        lede={hasPublications ? 'Peer-reviewed work, with links to the paper and code where available.' : undefined}
      />
      {
        hasPublications ? (
          <div class="pubs">
            {publicationItems.map((item, i) => (
              <PublicationEntry
                title={item.title}
                authors={item.authors}
                selfIndex={item.selfIndex}
                venue={item.venue}
                year={item.year}
                type={item.type}
                abbr={item.abbr}
                abstract={item.abstract}
                links={item.links}
                thumbnail={item.thumbnail}
                featured={item.featured}
                index={i}
              />
            ))}
          </div>
        ) : (
          <EmptyState message="Peer-reviewed papers will be listed here. There is nothing published yet — email me if you would like to know what I am working on." />
        )
      }
    </div>
  </section>

  <!-- 05 — Awards -->
  <section
    class:list={['section', 'section--ruled', { 'section--tight': !hasAwards }]}
    id="awards"
    aria-labelledby="awards-title"
  >
    <div class="container">
      <SectionHeader
        index="05"
        title="Honors &amp; Awards"
        id="awards"
        lede={hasAwards ? 'Scholarships, prizes, and recognitions.' : undefined}
      />
      {
        hasAwards ? (
          <AwardList items={awardItems} />
        ) : (
          <EmptyState message="Scholarships, prizes and recognitions will be listed here as they are earned." />
        )
      }
    </div>
  </section>

  <!-- 06 — Education -->
  <section class="section section--ruled" id="education" aria-labelledby="education-title">
    <div class="container">
      <SectionHeader index="06" title="Education" id="education" />
      <Timeline entries={education} />
    </div>
  </section>

  <!-- 07 — Experience -->
  <section
    class:list={['section', 'section--ruled', { 'section--tight': !hasExperience }]}
    id="experience"
    aria-labelledby="experience-title"
  >
    <div class="container">
      <SectionHeader
        index="07"
        title="Experience"
        id="experience"
        lede={hasExperience ? 'Research and industry positions.' : undefined}
      />
      {
        hasExperience ? (
          <ExperienceList items={experienceItems} />
        ) : (
          <EmptyState message="Research and industry positions will be listed here. None to show at the moment." />
        )
      }
    </div>
  </section>

  <!-- 08 — Contact -->
  <section class="section section--ruled" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <SectionHeader
        index="08"
        title="Contact"
        id="contact"
        lede="Open to conversations about research, collaboration, or anything in the overlap."
      />
      <Contact />
    </div>
  </section>
</Base>

<style>
  /* The publications list supplies its own dividers; this only controls the
     rhythm between entries when thumbnails change the row heights. */
  .pubs {
    display: flex;
    flex-direction: column;
  }
</style>
