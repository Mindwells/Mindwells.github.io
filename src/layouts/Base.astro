---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, activeLinks } from '../data/profile';
import { education } from '../data/education';
import { researchAreas, researchSummary } from '../data/research';

export interface Props {
  title?: string;
  description?: string;
  /** Rendered as the <title> verbatim when set. */
  fullTitle?: string;
}

const {
  title,
  description = profile.bio,
  fullTitle,
} = Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://mindwells.github.io').href;

// Everything below is derived from `src/data/*` rather than restated here, so
// changing a link or a school updates the structured data too.
const emailLink = activeLinks.find((link) => link.icon === 'mail');
const externalUrls = activeLinks
  .map((link) => link.href)
  .filter((href): href is string => typeof href === 'string' && href.startsWith('http'));

// schema.org Person — the machine-readable half of "this is who I am".
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  affiliation: {
    '@type': 'Organization',
    name: profile.affiliation,
  },
  alumniOf: education.map((entry) => ({
    '@type': 'Organization',
    name: entry.institution,
  })),
  ...(emailLink?.href ? { email: emailLink.href } : {}),
  url: canonical,
  ...(externalUrls.length > 0 ? { sameAs: externalUrls } : {}),
  knowsAbout: [researchSummary, ...researchAreas.map((area) => area.title)],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Icons -->
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/images/site.webmanifest" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!--
      Set the `js` class before first paint so reveal animations only hide
      content when there is JavaScript available to bring it back. Without
      this, a no-JS visitor would see a blank page.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            root.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* storage unavailable — fall back to the system preference */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!--
      The single site-wide enhancement bundle: scroll reveal, active-section
      navigation, theme toggle, copy-to-clipboard. Every feature in it is an
      enhancement — the page is complete and readable without it.
    -->
    <script>
      import '../scripts/enhance.ts';
    </script>
  </body>
</html>
